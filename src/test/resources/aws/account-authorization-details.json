{
  "RoleDetailList": [
    {
      "RoleName": "deploy-role",
      "RoleId": "AROA111111111111DEPLOY",
      "Arn": "arn:aws:iam::111111111111:role/deploy-role",
      "AssumeRolePolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Federated": "arn:aws:iam::111111111111:oidc-provider/token.actions.githubusercontent.com"
            },
            "Action": "sts:AssumeRoleWithWebIdentity",
            "Condition": {
              "StringEquals": {
                "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                "token.actions.githubusercontent.com:sub": "repo:demo-org/shop-web:pull_request"
              }
            }
          }
        ]
      },
      "RolePolicyList": [
        {
          "PolicyName": "DeployerInlinePolicy",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": ["iam:PassRole"],
                "Resource": "arn:aws:iam::111111111111:role/admin-role"
              },
              {
                "Effect": "Allow",
                "Action": ["lambda:CreateFunction"],
                "Resource": "*"
              },
              {
                "Effect": "Allow",
                "Action": ["lambda:UpdateFunctionCode"],
                "Resource": "arn:aws:lambda:us-east-1:111111111111:function:billing-lambda"
              },
              {
                "Effect": "Allow",
                "Action": ["s3:GetObject", "s3:PutObject"],
                "Resource": "arn:aws:s3:::build-artifacts/*"
              }
            ]
          }
        }
      ],
      "AttachedManagedPolicies": []
    },
    {
      "RoleName": "admin-role",
      "RoleId": "AROA111111111111ADMIN",
      "Arn": "arn:aws:iam::111111111111:role/admin-role",
      "AssumeRolePolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "AWS": "arn:aws:iam::111111111111:root"
            },
            "Action": "sts:AssumeRole"
          }
        ]
      },
      "RolePolicyList": [],
      "AttachedManagedPolicies": [
        {
          "PolicyName": "AdministratorAccess",
          "PolicyArn": "arn:aws:iam::aws:policy/AdministratorAccess"
        }
      ]
    },
    {
      "RoleName": "readonly-role",
      "RoleId": "AROA111111111111READONLY",
      "Arn": "arn:aws:iam::111111111111:role/readonly-role",
      "AssumeRolePolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Federated": "arn:aws:iam::111111111111:oidc-provider/token.actions.githubusercontent.com"
            },
            "Action": "sts:AssumeRoleWithWebIdentity",
            "Condition": {
              "StringEquals": {
                "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                "token.actions.githubusercontent.com:sub": "repo:demo-org/shop-web:ref:refs/heads/main"
              }
            }
          }
        ]
      },
      "RolePolicyList": [
        {
          "PolicyName": "ReadOnlyInline",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": ["s3:GetObject"],
                "Resource": "arn:aws:s3:::build-artifacts/*"
              }
            ]
          }
        }
      ],
      "AttachedManagedPolicies": []
    },
    {
      "RoleName": "overbroad-oidc-role",
      "RoleId": "AROA111111111111OVERBROAD",
      "Arn": "arn:aws:iam::111111111111:role/overbroad-oidc-role",
      "AssumeRolePolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Federated": "arn:aws:iam::111111111111:oidc-provider/token.actions.githubusercontent.com"
            },
            "Action": "sts:AssumeRoleWithWebIdentity",
            "Condition": {
              "StringLike": {
                "token.actions.githubusercontent.com:sub": "repo:demo-org/*"
              }
            }
          }
        ]
      },
      "RolePolicyList": [
        {
          "PolicyName": "OverbroadInline",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": ["*"],
                "Resource": "*"
              }
            ]
          }
        }
      ],
      "AttachedManagedPolicies": []
    }
  ],
  "UserDetailList": [],
  "GroupDetailList": [],
  "Policies": [
    {
      "PolicyName": "AdministratorAccess",
      "PolicyId": "ANPA111111111111ADMIN",
      "Arn": "arn:aws:iam::aws:policy/AdministratorAccess",
      "PolicyVersionList": [
        {
          "VersionId": "v1",
          "IsDefaultVersion": true,
          "Document": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": "*",
                "Resource": "*"
              }
            ]
          }
        }
      ]
    }
  ]
}
